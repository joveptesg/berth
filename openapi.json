{
  "openapi": "3.1.0",
  "info": {
    "title": "Berth API",
    "description": "",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/admin/pairing-tokens": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Issue a one-time pairing code (lives 120 s).",
        "operationId": "create_pairing_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairingTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Pairing code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: the device has no `admin` scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: no such user",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/storage-profiles": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List storage profiles, oldest first.",
        "operationId": "list_storage_profiles",
        "responses": {
          "200": {
            "description": "Profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StorageProfile"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: the device has no `admin` scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Add a storage profile. It is not checked: call `verify` next.",
        "operationId": "create_storage_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StorageProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageProfile"
                }
              }
            }
          },
          "400": {
            "description": "`validation`; `detail`: `storage_name_required`, `storage_name_too_long`, `storage_name_taken`, `storage_path_required`, `storage_bucket_required`, `storage_endpoint_invalid`, `storage_delivery_invalid`, `storage_keys_required` or `invalid_body`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: the device has no `admin` scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/storage-profiles/{id}": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "One storage profile.",
        "operationId": "get_storage_profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Profile id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageProfile"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: the device has no `admin` scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Replace a storage profile; absent keys keep the saved ones. A new location or new keys\nclear the last check.",
        "operationId": "update_storage_profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Profile id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StorageProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageProfile"
                }
              }
            }
          },
          "400": {
            "description": "`validation`; `detail` as for create, or `storage_kind_invalid` when the type changes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: the device has no `admin` scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`conflict`; `detail`: `storage_in_use` (blobs are stored at the old location)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Delete a storage profile that holds nothing and is not the default.",
        "operationId": "delete_storage_profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Profile id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: the device has no `admin` scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`conflict`; `detail`: `storage_is_default` or `storage_in_use`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/storage-profiles/{id}/default": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Make the profile the default: new books go there.",
        "operationId": "default_storage_profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Profile id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The new default profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageProfile"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: the device has no `admin` scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/storage-profiles/{id}/verify": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Check the connection: write, read back and delete a probe object. The result is in\n`verified_at` / `verify_error`; a failed check is not an HTTP error.",
        "operationId": "verify_storage_profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Profile id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile with the check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageProfile"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`forbidden`: the device has no `admin` scope",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/pair": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchange a pairing code for device tokens. Rate limited per client address.",
        "operationId": "pair",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Device paired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairResponse"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_body`, `validation` (`platform_invalid`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "`pairing_token_invalid`, `pairing_token_used` or `pairing_token_expired`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Rotate the refresh token. A token presented again within 45 s gets the same new pair;\nlater reuse ends the device's session (`session_expired`).",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_body`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "`session_expired` (pair again, keep downloads) or `device_revoked` (wipe local data)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/v1/auth/revoke": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke the calling device (sign out). Its tokens stop working at once.",
        "operationId": "revoke",
        "responses": {
          "204": {
            "description": "Device revoked"
          },
          "401": {
            "description": "`unauthenticated` or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current user and device. Clients call it to check the session; errors tell them to\nre-pair (`session_expired` on refresh) or wipe data (`device_revoked`).",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "Current user and device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated` (refresh and retry) or `device_revoked`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/server-info": {
      "get": {
        "tags": [
          "server"
        ],
        "summary": "Server info (no authentication).",
        "operationId": "server_info",
        "responses": {
          "200": {
            "description": "Server info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthMode": {
        "type": "string",
        "description": "Client login method.",
        "enum": [
          "pairing"
        ]
      },
      "DeliveryMode": {
        "type": "string",
        "description": "How clients get the bytes.",
        "enum": [
          "proxy",
          "presigned",
          "cdn"
        ]
      },
      "Me": {
        "type": "object",
        "description": "The calling device and its user.",
        "required": [
          "user_id",
          "user_name",
          "device_id",
          "scopes"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "description": "Device id."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Device scopes: `listen`, `upload`, `admin`, `feed`."
          },
          "user_id": {
            "type": "string",
            "description": "User id."
          },
          "user_name": {
            "type": "string",
            "description": "User name."
          }
        }
      },
      "MinClientVersion": {
        "type": "object",
        "description": "Oldest supported versions per client type.",
        "required": [
          "mobile"
        ],
        "properties": {
          "mobile": {
            "type": "string",
            "description": "Mobile app."
          }
        }
      },
      "PairRequest": {
        "type": "object",
        "description": "`POST /v1/auth/pair` request.",
        "required": [
          "pairing_token",
          "device_name",
          "platform"
        ],
        "properties": {
          "device_name": {
            "type": "string",
            "description": "Human-readable device name, e.g. \"Pixel 9\"."
          },
          "pairing_token": {
            "type": "string",
            "description": "Code from the QR or typed by hand (8 characters; case and separators are ignored)."
          },
          "platform": {
            "type": "string",
            "description": "Lower-case platform: `android`, `ios`, …"
          }
        }
      },
      "PairResponse": {
        "type": "object",
        "description": "Tokens of a newly paired device.",
        "required": [
          "device_id",
          "access_token",
          "refresh_token",
          "access_expires_in"
        ],
        "properties": {
          "access_expires_in": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until the access token expires; refresh ahead of it."
          },
          "access_token": {
            "type": "string",
            "description": "JWT for `Authorization: Bearer`."
          },
          "device_id": {
            "type": "string",
            "description": "Id of the new device."
          },
          "refresh_token": {
            "type": "string",
            "description": "One-time refresh token; every refresh returns the next one."
          }
        }
      },
      "PairingTokenRequest": {
        "type": "object",
        "description": "`POST /v1/admin/pairing-tokens` request.",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "description": "User the phone will belong to."
          }
        }
      },
      "PairingTokenResponse": {
        "type": "object",
        "description": "A pairing code and the QR payload around it.",
        "required": [
          "pairing_token",
          "server_urls",
          "expires_at",
          "expires_in"
        ],
        "properties": {
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "Expiry, epoch milliseconds."
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until expiry."
          },
          "pairing_token": {
            "type": "string",
            "description": "8-character one-time code; the QR carries `{server_urls, pairing_token}`."
          },
          "server_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Server addresses for the QR: home network first, then internet (from settings)."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "Problem details (RFC 9457).",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable code, e.g. `device_revoked` (wipe local data) or `session_expired` (re-pair)."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable explanation of this occurrence."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary."
          },
          "type": {
            "type": "string",
            "description": "URI identifying the problem type: `urn:berth:problem:<code>`."
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "description": "`POST /v1/auth/refresh` request.",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "description": "The current refresh token."
          }
        }
      },
      "ServerInfo": {
        "type": "object",
        "description": "Public server description used for discovery before login.",
        "required": [
          "name",
          "server_id",
          "version",
          "auth_modes",
          "min_client_version"
        ],
        "properties": {
          "auth_modes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthMode"
            },
            "description": "Login methods available to clients."
          },
          "min_client_version": {
            "$ref": "#/components/schemas/MinClientVersion",
            "description": "Oldest client versions the server supports."
          },
          "name": {
            "type": "string",
            "description": "Server name set by the admin."
          },
          "server_id": {
            "type": "string",
            "description": "Stable server identity: a client switching between LAN and WAN addresses\naccepts only the address that reports the same id."
          },
          "version": {
            "type": "string",
            "description": "Server version."
          }
        }
      },
      "StorageKind": {
        "type": "string",
        "description": "Where the bytes are.",
        "enum": [
          "local",
          "s3"
        ]
      },
      "StorageProfile": {
        "type": "object",
        "description": "A storage profile; keys are never returned.",
        "required": [
          "id",
          "name",
          "kind",
          "delivery_mode",
          "is_default",
          "created_at"
        ],
        "properties": {
          "bucket": {
            "type": [
              "string",
              "null"
            ],
            "description": "`s3`: bucket."
          },
          "created_at": {
            "type": "integer",
            "format": "int64",
            "description": "Creation time, epoch milliseconds."
          },
          "delivery_mode": {
            "$ref": "#/components/schemas/DeliveryMode",
            "description": "How clients get the bytes."
          },
          "endpoint": {
            "type": [
              "string",
              "null"
            ],
